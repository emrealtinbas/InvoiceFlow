# Copy this file to `.env` and replace every placeholder with local values.
# `.env` is gitignored; never commit real credentials.

# Development exposes Swagger UI at /swagger. Use Production behind a TLS proxy.
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL credentials. The database port is not published by default.
POSTGRES_DB=invoiceflow
POSTGRES_USER=invoiceflow
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# JWT configuration. The signing key must be at least 32 bytes.
Jwt__SigningKey=replace-with-a-random-key-of-at-least-32-bytes
Jwt__Issuer=InvoiceFlow
Jwt__Audience=InvoiceFlow.Api
Jwt__AccessTokenMinutes=30
