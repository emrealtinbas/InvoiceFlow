# Copy this file to `.env` before running the development server.
# `.env` is gitignored. Vite only exposes variables prefixed with VITE_ to the browser.

# Base URL of the InvoiceFlow API.
# - Docker Compose backend: http://localhost:8080
# - Local `dotnet run` backend: http://localhost:5188
# This value is public. Never place passwords, JWT signing keys, or other secrets here.
VITE_API_BASE_URL=http://localhost:8080

# The backend has no default cross-origin access. When the API runs with Docker Compose,
# configure a CORS origin for the Vite dev server. See frontend/docs/api-contract.md.
# Cors__AllowedOrigins__0=http://localhost:5173
