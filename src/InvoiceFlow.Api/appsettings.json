{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=invoiceflow;Username=invoiceflow"
  },
  "Jwt": {
    "Issuer": "InvoiceFlow",
    "Audience": "InvoiceFlow.Api",
    "AccessTokenMinutes": 30
  },
  "AdminProvisioning": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "WindowMinutes": 1,
    "Login": {
      "PermitLimit": 10
    },
    "Register": {
      "PermitLimit": 5
    }
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
